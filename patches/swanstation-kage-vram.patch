+++ b/src/core/kage_vram.h
@@ -0,0 +1,10 @@
+// Kage no Mon: cambio de texturas subidas a la VRAM (iconos de botones según el mando).
+#pragma once
+#include <cstdint>
+
+namespace KageVRAM {
+// Se llama con cada subida completa CPU->VRAM antes de aplicarla; puede modificar `data`.
+void OnWrite(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t* data);
+// Se llama una vez por frame: vuelve a subir lo que haya cambiado de variante.
+void Poll();
+} // namespace KageVRAM
